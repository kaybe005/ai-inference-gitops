# Copy this file to oidc.tf and provide real values through tfvars or environment variables.
# The GitHub OIDC provider itself can be managed separately or referenced by ARN.
module "github_oidc" {
  source                = "../modules/github_oidc"
  role_name             = "ai-inference-github-actions"
  oidc_provider_arn     = var.github_oidc_provider_arn
  repository            = var.github_repository
  ecr_repository_arn    = module.ecr.repository_arn
  state_bucket_arn      = var.state_bucket_arn
  lock_table_arn        = var.lock_table_arn
}
